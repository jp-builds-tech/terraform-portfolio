# My own stuff
personalnotes.txt

# Terraform working directories (all labs)
**/.terraform/**

# Terraform state files (all labs)
**/*.tfstate
**/*.tfstate.*

# Terraform crash logs
**/crash.log
**/crash.*.log

# Terraform saved plans
**/*.tfplan
**/tfplan
**/plan.out

# Variable files that may contain secrets
**/*.tfvars
**/*.tfvars.json
!**/example.tfvars
!**/example.tfvars.json

# Terraform override files
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Local environment and secret files
**/.env
**/.env.*
!**/.env.example

# Editor and operating system files
.DS_Store
Thumbs.db
.vscode/
.idea/